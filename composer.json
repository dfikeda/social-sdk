{
    "name": "dfikeda/social-sdk",
    "description": "Laravel SDK para redes sociais (Facebook Páginas e Instagram comercial) sobre Saloon",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "saloonphp/saloon": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dfikeda\\SocialSdk\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dfikeda\\SocialSdk\\SocialSdkServiceProvider"
            ]
        }
    }
}
